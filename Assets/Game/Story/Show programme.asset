%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b024d052715a824b99ca087409628737, type: 3}
  m_Name: Show programme
  m_EditorClassIdentifier: Assembly-CSharp::StoryBook
  conversations:
  - key: intro
    lines:
    - speaker: Swordsman
      portrait: {fileID: 2800000, guid: da2ff7dd5f5501afaa4c09c43f2bc154, type: 3}
      text: "My cuffs scrape the boards. Beyond the curtain, they\u2019re applauding
        the sound of my breathing."
      sound: {fileID: 8300000, guid: 8921f827b228f037cb474a068f5aeee3, type: 3}
      shotTime: 0
      startsApplause: 0
    - speaker: "Keeper\u2019s notice"
      portrait: {fileID: 2800000, guid: 5e4b1d8349f970dd39b8839e6773b4be, type: 3}
      text: "They took our crest, too. Beneath it, the old words: \u201COne stroke
        when a traveller comes home.\u201D"
      sound: {fileID: 0}
      shotTime: 3.15
      startsApplause: 0
    - speaker: Ringmaster
      portrait: {fileID: 2800000, guid: 1dcc5dbf8266b46438d5e3bbc48be910, type: 3}
      text: Listen closely. You can hear what the next swing will cost him.
      sound: {fileID: 8300000, guid: 186de84b3207156479abe98f4958fed0, type: 3}
      shotTime: 8.1
      startsApplause: 0
    - speaker: Ringmaster
      portrait: {fileID: 2800000, guid: 1dcc5dbf8266b46438d5e3bbc48be910, type: 3}
      text: Release his cuffs. Lights down. Lower the lift into the Garden.
      sound: {fileID: 8300000, guid: 186de84b3207156479abe98f4958fed0, type: 3}
      shotTime: 14.3
      startsApplause: 0
  - key: garden
    lines:
    - speaker: Ringmaster
      portrait: {fileID: 2800000, guid: 1dcc5dbf8266b46438d5e3bbc48be910, type: 3}
      text: Stand in the light and take it. Aim at the canister and press E, or strike
        a nearby flower with your sword (left click).
      sound: {fileID: 0}
      shotTime: 0
      startsApplause: 0
  - key: canister
    lines:
    - speaker: Ringmaster
      portrait: {fileID: 2800000, guid: 1dcc5dbf8266b46438d5e3bbc48be910, type: 3}
      text: Right on cue.
      sound: {fileID: 0}
      shotTime: 0
      startsApplause: 0
  - key: bulb
    lines:
    - speaker: Ringmaster
      portrait: {fileID: 2800000, guid: 1dcc5dbf8266b46438d5e3bbc48be910, type: 3}
      text: That flower was scenery.
      sound: {fileID: 0}
      shotTime: 0
      startsApplause: 0
  - key: portal
    lines:
    - speaker: Ringmaster
      portrait: {fileID: 2800000, guid: 1dcc5dbf8266b46438d5e3bbc48be910, type: 3}
      text: Clear the floor. The portal is lit. Back to the Stage.
      sound: {fileID: 0}
      shotTime: 0
      startsApplause: 0
  - key: interCanister
    lines:
    - speaker: Ringmaster
      portrait: {fileID: 2800000, guid: 1dcc5dbf8266b46438d5e3bbc48be910, type: 3}
      text: He knows where to stand.
      sound: {fileID: 8300000, guid: 186de84b3207156479abe98f4958fed0, type: 3}
      shotTime: 4.9
      startsApplause: 0
    - speaker: Ringmaster
      portrait: {fileID: 2800000, guid: 1dcc5dbf8266b46438d5e3bbc48be910, type: 3}
      text: For our next act, a piece of his own world. Bring up the Castle.
      sound: {fileID: 0}
      shotTime: 9.2
      startsApplause: 0
  - key: interBulb
    lines:
    - speaker: Ringmaster
      portrait: {fileID: 2800000, guid: 1dcc5dbf8266b46438d5e3bbc48be910, type: 3}
      text: Yes, of course the flower was my idea.
      sound: {fileID: 8300000, guid: 186de84b3207156479abe98f4958fed0, type: 3}
      shotTime: 4.9
      startsApplause: 0
    - speaker: Ringmaster
      portrait: {fileID: 2800000, guid: 1dcc5dbf8266b46438d5e3bbc48be910, type: 3}
      text: For our next act, a piece of his own world. Bring up the Castle.
      sound: {fileID: 0}
      shotTime: 9.2
      startsApplause: 0
  - key: castle
    lines:
    - speaker: Swordsman
      portrait: {fileID: 2800000, guid: da2ff7dd5f5501afaa4c09c43f2bc154, type: 3}
      text: Our towers. Our flags. Even the well. How much of home did they take?
      sound: {fileID: 0}
      shotTime: 0
      startsApplause: 0
  - key: notice
    lines:
    - speaker: "Keeper\u2019s notice"
      portrait: {fileID: 2800000, guid: 5e4b1d8349f970dd39b8839e6773b4be, type: 3}
      text: "The same crest as the Stage. \u201COne stroke when a traveller comes
        home.\u201D"
      sound: {fileID: 0}
      shotTime: 0
      startsApplause: 0
  - key: wait
    lines:
    - speaker: Ringmaster
      portrait: {fileID: 2800000, guid: 1dcc5dbf8266b46438d5e3bbc48be910, type: 3}
      text: Wait for my cue.
      sound: {fileID: 0}
      shotTime: 0
      startsApplause: 0
  - key: early
    lines:
    - speaker: Swordsman
      portrait: {fileID: 2800000, guid: da2ff7dd5f5501afaa4c09c43f2bc154, type: 3}
      text: A dull clank. The guards still hold the well.
      sound: {fileID: 0}
      shotTime: 0
      startsApplause: 0
  - key: home
    lines:
    - speaker: Swordsman
      portrait: {fileID: 2800000, guid: da2ff7dd5f5501afaa4c09c43f2bc154, type: 3}
      text: One stroke. For everyone who never made it home.
      sound: {fileID: 0}
      shotTime: 0
      startsApplause: 0
  - key: finale
    lines:
    - speaker: Swordsman
      portrait: {fileID: 2800000, guid: da2ff7dd5f5501afaa4c09c43f2bc154, type: 3}
      text: Back under the bare bulb. The broken cuffs lie where I left them.
      sound: {fileID: 0}
      shotTime: 0
      startsApplause: 0
    - speaker: Ringmaster
      portrait: {fileID: 2800000, guid: 1dcc5dbf8266b46438d5e3bbc48be910, type: 3}
      text: "Ladies and\u2014"
      sound: {fileID: 8300000, guid: 186de84b3207156479abe98f4958fed0, type: 3}
      shotTime: 8.15
      startsApplause: 1
    - speaker: Lead Spectator
      portrait: {fileID: 2800000, guid: c27f35931c714e6179400ccfd79b7886, type: 3}
      text: "Clap. Clap.     Clap.  The bell\u2019s rhythm, from the front row."
      sound: {fileID: 0}
      shotTime: 14.15
      startsApplause: 0
    - speaker: Audience
      portrait: {fileID: 2800000, guid: c27f35931c714e6179400ccfd79b7886, type: 3}
      text: Clap. Clap.     Clap.  The cane rises for silence. We keep going.
      sound: {fileID: 0}
      shotTime: 16
      startsApplause: 0
  clank: {fileID: 8300000, guid: be05bb9306c6a42ada3de6f5c779afb9, type: 3}
  bell: {fileID: 8300000, guid: 9b3b6e9ddf7fe36f6b0fd3cf991081e9, type: 3}
  breath: {fileID: 8300000, guid: f6b6ff43109aeeb349b3ca87cd096233, type: 3}
